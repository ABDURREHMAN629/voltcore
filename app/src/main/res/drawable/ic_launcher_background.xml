<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep navy ground, lit from the top-left so the mark reads as backlit. -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10" android:startY="4"
                android:endX="98" android:endY="104">
                <item android:offset="0.0" android:color="#FF16233F" />
                <item android:offset="0.45" android:color="#FF0C1428" />
                <item android:offset="1.0" android:color="#FF04070F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cyan bloom behind the ring. -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="50"
                android:gradientRadius="52">
                <item android:offset="0.0" android:color="#5522D3EE" />
                <item android:offset="0.55" android:color="#1D22D3EE" />
                <item android:offset="1.0" android:color="#0022D3EE" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
